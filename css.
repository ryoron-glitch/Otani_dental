body {  
    margin: 0;  
    font-family: "Hiragino Sans", sans-serif;  
    background: #F7FBFF;  
}  
  
/* Header */  
.header {  
    background: #6EC6FF;  
    padding: 15px;  
    text-align: center;  
    color: #fff;  
}  
.header nav a {  
    margin: 0 10px;  
    color: #fff;  
    text-decoration: none;  
}  
  
/* Hero */  
.hero {  
    text-align: center;  
    padding: 60px 20px;  
    background: #E8F6FF;  
}  
.hero h2 {  
    font-size: 28px;  
    color: #4A90E2;  
}  
.btn {  
    display: inline-block;  
    padding: 12px 25px;  
    background: #6EC6FF;  
    color: #fff;  
    border-radius: 25px;  
    text-decoration: none;  
    margin-top: 20px;  
}  
  
/* Features */  
.features {  
    text-align: center;  
    padding: 40px 20px;  
}  
.feature-box {  
    background: #fff;  
    margin: 20px auto;  
    padding: 20px;  
    border-radius: 20px;  
    max-width: 500px;  
    box-shadow: 0 3px 10px rgba(0,0,0,0.05);  
}  
.feature-box img {  
    width: 80px;  
}  
  
/* Footer */  
.footer {  
    text-align: center;  
    padding: 20px;  
    background: #6EC6FF;  
    color: #fff;  
}  
